# Copy to .env next to the binary (or point ENV_FILE at it). Real environment variables win over this file.

# Port on 127.0.0.1. The server never listens on other interfaces; nginx forwards to it.
PORT=8095

# SQLite file. Its folder must be writable by the service user.
DB_PATH=/var/lib/sudoku/sudoku.db

# Session cookie gets the Secure flag. Set to false only for local http development.
COOKIE_SECURE=true

# Extra origins allowed to POST/PUT/DELETE and open /ws, comma separated.
# Same-origin requests are always allowed, so this is usually empty.
ALLOWED_ORIGINS=

# Peers whose CF-Connecting-IP / X-Real-IP headers are trusted (nginx on this machine).
TRUSTED_PROXIES=127.0.0.1/32,::1/128
